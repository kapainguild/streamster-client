<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:Streamster.ClientCore.Models;assembly=Streamster.ClientCore" 
                    xmlns:data="clr-namespace:Streamster.ClientData.Model;assembly=Streamster.ClientData" 
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Common.xaml"/>
        <ResourceDictionary Source="EditingView.Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type data:OverlayDesc}">
        <TextBlock Text="{Binding Name}"/>
    </DataTemplate>


    <Style TargetType="{x:Type ListBoxItem}" x:Key="OverlayContainerStyle" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Margin" Value="0, 0, 0, 1"/>
        <Setter Property="Padding" Value="12, 4, 20, 4"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type models:OverlayPage}">
        <Grid Margin="0,5,0,0" >
            <DockPanel x:Name="configured" VerticalAlignment="Top">
                <Button DockPanel.Dock="Bottom" Content="Configure" 
                        HorizontalAlignment="Left" 
                        Command="{Binding GoToOverlayEditing, Converter={StaticResource CommandConverter}}"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}"/>
                <TextBlock Margin="0,10,0,8" DockPanel.Dock="Bottom" Text="You can configure overlays in our web application" />
                <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Text="Select configured overlay"/>
                <ListBox ItemsSource="{Binding Overlays.Value}" SelectedItem="{Binding CurrentOverlay.Value}" HorizontalAlignment="Left"
                         ItemContainerStyle="{StaticResource OverlayContainerStyle}">
                </ListBox>
            </DockPanel>

            <DockPanel x:Name="notconfigured" VerticalAlignment="Top" Visibility="Collapsed">
                <Button DockPanel.Dock="Bottom" 
                        Content="Configure Overlays" 
                        HorizontalAlignment="Left" 
                        Command="{Binding GoToOverlayEditing, Converter={StaticResource CommandConverter}}"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}"/>
                <TextBlock Margin="0,10,0,15" Text="You have not yet configured any overlays. You can configure the overlays in our web application"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Grid>
        
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding NoOverlays.Value}" Value="True">
                <Setter TargetName="configured" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="notconfigured" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>