<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chats="clr-namespace:Streamster.ClientCore.Models.Chats;assembly=Streamster.ClientCore" 
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:support="clr-namespace:Streamster.ClientApp.Win.Support"
                    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Common.xaml"/>
        <ResourceDictionary Source="../Transcoding.xaml"/>
        <ResourceDictionary Source="UserPasswordAuthenticationView.xaml"/>
        <ResourceDictionary Source="WebBrowserAuthenticationView.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="ContentOnlyTemplate" TargetType="{x:Type Button}">
        <ContentPresenter />
    </ControlTemplate>

    <DataTemplate DataType="{x:Type chats:ClientChatMessage}" x:Key="ChatMessage">

        <Button Template="{StaticResource ContentOnlyTemplate}" Command="{Binding SelectUser, Converter={StaticResource CommandConverter}}"
                Style="{StaticResource EmptyButton}">
            <Border x:Name="root" Margin="2,2,30,1" CornerRadius="10,10,10,10" BorderBrush="#808080" Background="#152530" HorizontalAlignment="Left">
                <DockPanel>
                    <TextBlock x:Name="author" Margin="8,5,8,0" DockPanel.Dock="Top" Text="{Binding Author}" FontWeight="Normal" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           FontSize="{Binding Platforms.FontSizeAuthor.Value}" Foreground="#d0d000"/>
                    <emoji:TextBlock Margin="8,5" Text="{Binding Message}" Foreground="#dddddd" FontWeight="Normal" TextWrapping="Wrap"
                                     FontSize="{Binding Platforms.FontSize.Value}" />
                </DockPanel>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Self}" Value="True"/>
                    <Condition Binding="{Binding First}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="root" Property="Margin" Value="30,5,2,1"/>
                <Setter TargetName="root" Property="CornerRadius" Value="10,1,10,10"/>
                <Setter TargetName="root" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="root" Property="Background" Value="#153025"/>
            </MultiDataTrigger>
            
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Self}" Value="False"/>
                    <Condition Binding="{Binding First}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="root" Property="Margin" Value="2,5,30,1"/>
                <Setter TargetName="root" Property="CornerRadius" Value="1,10,10,10"/>
            </MultiDataTrigger>
            
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Self}" Value="True"/>
                    <Condition Binding="{Binding First}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="root" Property="Margin" Value="30,2,2,1"/>
                <Setter TargetName="root" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="root" Property="Background" Value="#153025"/>
            </MultiDataTrigger>

            <DataTrigger Binding="{Binding ShowAuthor}" Value="True">
                <Setter TargetName="author" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Type}" Value="Tip"/>
                    <Condition Binding="{Binding Private}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="root" Property="Background" Value="#953025"/>
                <Setter TargetName="author" Property="Foreground" Value="#FFFF99"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Type}" Value="Tip"/>
                    <Condition Binding="{Binding Private}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="root" Property="Background" Value="#450005"/>
                <Setter TargetName="author" Property="Foreground" Value="#FFFF99"/>
                <Setter TargetName="root" Property="BorderThickness" Value="1"/>
            </MultiDataTrigger>


            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Type}" Value="Message"/>
                    <Condition Binding="{Binding Private}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="root" Property="Background" Value="Black"/>
                <Setter TargetName="root" Property="BorderThickness" Value="1"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type chats:ChatModel}" x:Key="ChatTemplate">
        <Border Background="#101010" Margin="0,5,3,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#303030">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" x:Name="logo" Margin="5,0" Height="30" Source="{Binding Logo.Value, Converter={StaticResource ImageConverter}}"/>
                        <Button DockPanel.Dock="Right" Margin="5,5,5,5" 
                                  Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                                                      Width="30" Height="30"
                                Command="{Binding Close, Converter={StaticResource CommandConverter}}"
                                                                      ToolTip="Close chat / disconnect from site">
                            <materialDesign:PackIcon Kind="Close" Height="20" Width="20" />
                        </Button>

                        <materialDesign:PopupBox 
                                    DockPanel.Dock="Right"
                                    PlacementMode="BottomAndAlignCentres"
                                    StaysOpen="False">
                            <StackPanel>
                                <Button Content="Logout" Command="{Binding AuthenticateModel.Logout, Converter={StaticResource CommandConverter}}"/>
                            </StackPanel>
                        </materialDesign:PopupBox>

                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <Border x:Name="main" Background="#141414">
                    <Grid>
                        <DockPanel x:Name="connected" Margin="20" >
                            <DockPanel DockPanel.Dock="Bottom">
                                <Button DockPanel.Dock="Right" Height="30" Margin="5,0,0,0" Content="Send" 
                                        Padding="8,5"
                                        Command="{Binding SendMessage, Converter={StaticResource CommandConverter}}"/>
                                <Border x:Name="sendMessageTo" 
                                        Margin="0,-4,6,-4"
                                        BorderThickness="1,1,1,1"
                                        BorderBrush="#606060"
                                        DockPanel.Dock="Left" Height="38" CornerRadius="11,0,0,11" Background="Black" HorizontalAlignment="Left">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                                Command="{Binding ResetSendMessageTo, Converter={StaticResource CommandConverter}}"
                                                Margin="3,0,0,0"
                                                Width="34" Height="34">
                                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Top" Text="private to" FontWeight="Normal" 
                                                   Margin="10,4,0,0"
                                                   FontSize="10" Foreground="#d0d000"/>     
                                        <TextBlock Text="{Binding SendMessageTo.Value}" MaxWidth="100" TextTrimming="CharacterEllipsis"
                                                   Margin="10,0,0,0"/>
                                    </DockPanel>
                                </Border>
                                <TextBox x:Name="message" Text="{Binding Message.Value, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Say in private...">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendMessage, Converter={StaticResource CommandConverter}}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <Grid Margin="0,0,-15,5">
                                <Border x:Name="allMessages" Visibility="Collapsed">
                                    <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatMessage}" 
                                              support:AutoScrollToBottomBehavior.AutoScrollToBottomStatus="{Binding MessagesScroll.Value}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer CanContentScroll="True" Focusable="False" >
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                    </ItemsControl>
                                </Border>
                                <Border x:Name="filteredMessages">
                                    <ItemsControl ItemsSource="{Binding FilteredMessages}" ItemTemplate="{StaticResource ChatMessage}"
                                              support:AutoScrollToBottomBehavior.AutoScrollToBottomStatus="{Binding FilteredMessagesScroll.Value}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <Border>
                                                    <ScrollViewer CanContentScroll="True" Focusable="False">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </DockPanel>

                        <TextBlock Margin="20" x:Name="noissue" Visibility="Collapsed" Text="{Binding StateDetails.Value}" />

                        <Border x:Name="issue" Background="#701020" Visibility="Collapsed" VerticalAlignment="Top">
                            <WrapPanel Margin="13,5,0,5" >
                                <materialDesign:PackIcon Margin="0,2,7,2" VerticalAlignment="Center" 
                                                         Width="20" Height="20" 
                                                         Foreground="#FFaa66"
                                                         
                                                         Kind="WarningOutline"/>
                                <TextBlock x:Name="issueTitle" Margin="0,2,10,2" Text="{Binding StateDetails.Value}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Margin="0,2,10,2" x:Name="relogin" VerticalAlignment="Center">
                                        <Button x:Name="loginButtonCommand" HorizontalAlignment="Left" 
                                                Content="Login" 
                                                Command="{Binding AuthenticateModel.Login, Converter={StaticResource CommandConverter}}"/>
                                        <Button Visibility="Collapsed"
                                                x:Name="loginButtonPopup" HorizontalAlignment="Left" 
                                                Content="Login" 
                                                Command="{Binding AuthenticateModel.Login, Converter={StaticResource OpenDialogCommandConverter}}">
                                            <Button.CommandParameter>
                                                <ContentControl Content="{Binding AuthenticateModel}"/>
                                            </Button.CommandParameter>
                                        </Button>
                                    </Grid>
                                    <Button Margin="0,2,10,2" x:Name="reconnect" Content="Reconnect" VerticalAlignment="Center"
                                            Command="{Binding Reconnect, Converter={StaticResource CommandConverter}}"/>

                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>
                
            </DockPanel>
            
        </Border>

        <DataTemplate.Triggers>

            <DataTrigger Binding="{Binding AuthenticateModel.ShowPopupDialog}" Value="True">
                <Setter TargetName="loginButtonCommand" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="loginButtonPopup" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding SendMessageTo.Value}" Value="{x:Null}">
                <Setter TargetName="sendMessageTo" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="allMessages" Property="Visibility" Value="Visible"/>
                <Setter TargetName="filteredMessages" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="main" Property="Background" Value="#101010"/>
                <Setter TargetName="message" Property="materialDesign:HintAssist.Hint" Value="Say something..."/>
            </DataTrigger>

            <DataTrigger Binding="{Binding State.Value}" Value="Initializing">
                <Setter TargetName="noissue" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding State.Value}" Value="Connecting">
                <Setter TargetName="noissue" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding State.Value}" Value="Connected">
                <Setter TargetName="connected" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding State.Value}" Value="NotAuthenticated">
                <Setter TargetName="issue" Property="Visibility" Value="Visible"/>
                <Setter TargetName="reconnect" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="relogin" Property="HorizontalAlignment" Value="Left"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding State.Value}" Value="ConnectionFailed">
                <Setter TargetName="issue" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding State.Value}" Value="ConnectionNotInitialized">
                <Setter TargetName="issue" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


    <DataTemplate DataType="{x:Type chats:PlatformsModel}">

        <Border Background="#1A1A1A">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="30" Background="#101010" >
                </Border>

                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Left" Margin="10,0,15,0" VerticalAlignment="Center" Text="Chats" Foreground="#808089"/>
                    <ToggleButton DockPanel.Dock="Right" Margin="0,5,10,5" 
                                  Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                                                      IsChecked="{Binding IsChatsOpened.Value}"
                                                                      Width="30" Height="30"
                                                                      ToolTip="Close chats">
                        <materialDesign:PackIcon Kind="ArrowCollapseRight" Height="20" Width="20" />
                    </ToggleButton>
                    <materialDesign:PopupBox DockPanel.Dock="Right" Style="{StaticResource TranscodingPopupBox}"
                                     PlacementMode="BottomAndAlignRightEdges"
                                     ToolTipService.Placement="Right"
                                     PopupMode="Click"
                                     ToolTip="Chats settings">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon Width="19" Height="19" Kind="Cog" Foreground="White"/>
                        </materialDesign:PopupBox.ToggleContent>
                        <Border Background="Black" BorderBrush="#1883D7" BorderThickness="1">
                            <StackPanel Margin="25, 20">
                                <TextBlock HorizontalAlignment="Left" Text="Message font size"/>
                                <Slider Margin="0,8,0,0" Minimum="10" Maximum="30" Value="{Binding FontSize.Value}" Width="120"/>
                            </StackPanel>
                        </Border>
                    </materialDesign:PopupBox>
                    <ItemsControl ItemsSource="{Binding ChatsToAdd}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type chats:ChatToAdd}">
                                <Button Margin="0,0,10,1" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Command="{Binding Add, Converter={StaticResource CommandConverter}}"
                                        Padding="3,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Height="24" Width="24" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="2,0,0,0" FontWeight="Normal"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
                <Border Background="#1A1A1A">
                    <Grid>
                        <TextBlock x:Name="SupportedChannels" 
                                   Margin="20"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="{Binding SupportedChannels}" Visibility="Collapsed"/>
                        <ItemsControl ItemsSource="{Binding Chats}" ItemTemplate="{StaticResource ChatTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Chats.Count}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasSupportedChannels.Value}" Value="False">
                <Setter TargetName="SupportedChannels" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    
</ResourceDictionary>